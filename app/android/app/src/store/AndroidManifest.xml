<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- WorkManager (ADR-049) declares a boot permission and receiver; only the
         enterprise flavour may hold RECEIVE_BOOT_COMPLETED (docs/07, B2B-002).
         Scheduled jobs resume when the app next starts and schedules them again.
         Its foreground service is never used, so it is not declared either. -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />
    <application>
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />
        <!-- Play Billing links Google Data Transport (its own usage reporting). The
             CCT backend that uploads is excluded in build.gradle.kts; the job and
             alarm that would retry uploads are not declared either (no telemetry). -->
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            tools:node="remove" />
        <receiver
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            tools:node="remove" />
    </application>
</manifest>
