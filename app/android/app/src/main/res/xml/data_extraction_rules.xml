<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device transfer (PRIV-006): sealed secrets
     need Keystore keys that never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mediahro.secure.xml" />
        <exclude domain="file" path="photo-trash" />
        <!-- Where comics were left off (IMG-017): reading history stays on the device. -->
        <exclude domain="file" path="photos-private" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mediahro.secure.xml" />
        <exclude domain="file" path="photo-trash" />
        <!-- Where comics were left off (IMG-017): reading history stays on the device. -->
        <exclude domain="file" path="photos-private" />
    </device-transfer>
</data-extraction-rules>
