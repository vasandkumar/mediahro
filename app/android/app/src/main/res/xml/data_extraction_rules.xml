<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device transfer (PRIV-006): sealed secrets
     need Keystore keys that never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mediahro.secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mediahro.secure.xml" />
    </device-transfer>
</data-extraction-rules>
