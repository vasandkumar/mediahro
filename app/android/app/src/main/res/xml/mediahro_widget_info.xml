<?xml version="1.0" encoding="utf-8"?>
<!-- Now-playing widget (MUS-012): 4x1, resizable, home screen and lock screen. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/mediahro_widget_description"
    android:initialLayout="@layout/mediahro_widget"
    android:minWidth="250dp"
    android:minHeight="56dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="56dp"
    android:previewLayout="@layout/mediahro_widget"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard" />
