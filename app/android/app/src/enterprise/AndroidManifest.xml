<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Kiosk and signage start after boot (B2B-002). Only the enterprise
         flavour declares this (tools/compliance/check_manifests.py). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application>
        <receiver
            android:name="com.mediahro.mediahro.platform.enterprise.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
