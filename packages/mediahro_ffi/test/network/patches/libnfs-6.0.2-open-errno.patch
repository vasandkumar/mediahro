libnfs 6.0.2: a failed NFSv3 open passes the errno it already has through
nfsstat3_to_errno() a second time, which turns every error (NFS3ERR_NOENT,
ACCES, NOTDIR, STALE...) into -EIO. Backport of upstream master, which
passes err through unchanged. Mediahro lane B2; also carried in
mediahro-deps patches/libnfs/.

--- a/lib/nfs_v3.c
+++ b/lib/nfs_v3.c
@@ -4801,7 +4801,7 @@
 	struct open_cb_data *cb_data = private_data;
 
         if (err) {
-		cb_data->cb(nfsstat3_to_errno(err), nfs,
+		cb_data->cb(err, nfs,
                          nfs_get_error(nfs), cb_data->private_data);
                 free_open_cb_data(cb_data);
                 return;
@@ -4961,7 +4961,7 @@
                 return;
         }
         if (err) {
-                cb_data->cb(nfsstat3_to_errno(err), nfs,
+                cb_data->cb(err, nfs,
                             nfs_get_error(nfs), cb_data->private_data);
                 free_open_cb_data(cb_data);
                 return;
