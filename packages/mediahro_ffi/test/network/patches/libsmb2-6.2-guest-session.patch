+                    (p->header.command == SMB2_TREE_CONNECT && smb2->dialect == SMB2_VERSION_0311 &&
+                     !smb2->seal && !smb2->guest)) {
                         if (smb2_pdu_add_signature(smb2, p) < 0) {
                                 smb2_set_error(smb2, "Failure to add "
                                                "signature. %s",
diff -ru a/lib/smb2-cmd-tree-connect.c b/lib/smb2-cmd-tree-connect.c
