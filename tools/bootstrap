#!/usr/bin/env bash
# One-time (and post-pull) setup: dependencies, merged ARB files, generated
# localisations, pinned native deps. Safe to re-run.
set -euo pipefail
cd "$(dirname "$0")/.."
FLUTTER="${FLUTTER:-flutter}"
DART="${DART:-dart}"
# Merge ARB fragments first: `flutter pub get` runs gen-l10n (generate: true),
# which needs the merged files. The merge script uses only dart:core/io.
"$DART" tools/l10n/merge_arb.dart
"$FLUTTER" pub get
(cd app && "$FLUTTER" gen-l10n)
PY=python3; "$PY" --version >/dev/null 2>&1 || PY=python
"$PY" tools/deps/fetch.py
